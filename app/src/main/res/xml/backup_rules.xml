<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and older; see data_extraction_rules.xml for the reasoning and
  for Android 12+. Backups are off altogether (android:allowBackup="false"), and these excludes
  say the same thing for any tool that reads the rules rather than the flag.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
