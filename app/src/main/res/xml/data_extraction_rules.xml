<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing the app keeps on the device is worth carrying to another one: every block, listing,
  booking and profile lives in Firestore and is back after signing in. What is on disk is the
  Firestore offline cache and the Firebase sign-in state, and restoring either onto a different
  device or a later install only causes trouble.

  Backups are therefore switched off. android:allowBackup="false" in the manifest covers
  Android 11 and older; these rules do the same for cloud backup and device-to-device transfer
  on Android 12 and newer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
